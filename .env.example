# ============================================================
# Zalo Bot SDK - Environment Variables Template
# ============================================================
# Copy file này thành .env và điền thông tin của bạn
# TUYỆT ĐỐI KHÔNG commit file .env chứa token thật lên Git!

# ------------------------------------------------------------
# BẮT BUỘC (REQUIRED)
# ------------------------------------------------------------

# Zalo Bot / OA Access Token
# Lấy từ: https://developers.zalo.me/ hoặc trang quản trị Zalo Bot
ZALO_BOT_ACCESS_TOKEN=YOUR_ZALO_BOT_ACCESS_TOKEN_HERE

# ------------------------------------------------------------
# TÙY CHỌN (OPTIONAL / RECOMMENDED)
# ------------------------------------------------------------

# Secret Key dùng để xác thực Webhook (HMAC-SHA256)
# Cấu hình tại mục Webhook trên trang Zalo Bot Developer
ZALO_BOT_SECRET_KEY=YOUR_ZALO_BOT_SECRET_KEY_HERE

# Zalo App ID
# ZALO_BOT_APP_ID=YOUR_APP_ID_HERE

# Webhook URL (chỉ dùng tham chiếu, cấu hình domain thực tế của bạn)
# ZALO_BOT_WEBHOOK_URL=https://your-domain.com/webhook

# Cổng chạy Webhook Server mẫu
PORT=3000

# Base URL của Webhook Server
BASE_URL=https://your-domain.com

# Request Timeout (mili-giây, mặc định 30000ms = 30s)
ZALO_BOT_TIMEOUT=30000

# Số lần thử lại tối đa khi gặp Rate Limit hoặc lỗi mạng tạm thời
ZALO_BOT_MAX_RETRIES=3

# Zalo API Base URL (mặc định https://graph.zalo.me/v2.0)
ZALO_BOT_BASE_URL=https://graph.zalo.me/v2.0

# User ID mẫu để chạy thử file ví dụ send-message.js
ZALO_BOT_TEST_USER_ID=USER_ID_TO_TEST
