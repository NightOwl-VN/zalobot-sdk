{
  "name": "zalobot-sdk",
  "version": "1.0.0",
  "description": "A lightweight, modular Node.js SDK and Webhook handler for Zalo Bot API. Fully typed with JSDoc and ready for production.",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm test",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "zalo",
    "bot",
    "sdk",
    "zalobot",
    "webhook",
    "oa",
    "nodejs",
    "javascript",
    "express",
    "bot-framework",
    "zalo-bot-api",
    "zalo-sdk"
  ],
  "author": "Hoang Khac Phuc <hoangkhacphuc.dev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NightOwl-VN/zalobot-sdk.git"
  },
  "homepage": "https://github.com/NightOwl-VN/zalobot-sdk#readme",
  "bugs": {
    "url": "https://github.com/NightOwl-VN/zalobot-sdk/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "src/",
    "types/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "eslint": "^9.39.5"
  }
}
